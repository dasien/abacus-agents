{
  "name": "agent:planner",
  "writable": [
    "state"
  ],
  "commands": [
    "abacus-board find *",
    "abacus-board brief *",
    "abacus-logbook digest",
    "abacus-logbook show *",
    "abacus-logbook ruling recorded *",
    "abacus-session list",
    "abacus-session stop agent:planner *",
    "abacus-memory consult *",
    "bd show *",
    "bd list",
    "bd list *",
    "bd ready *",
    "bd where *",
    "bd create *",
    "bd update *",
    "bd close *",
    "bd dep add *",
    "bd dep list *",
    "bd label add *",
    "bd label remove *",
    "bd label list *",
    "git rev-parse *",
    "git log *",
    "git show *",
    "git grep *",
    "git ls-files *",
    "git branch *",
    "git -C * branch *",
    "git -C * rev-parse *",
    "git -C * log *",
    "git -C * show *",
    "git -C * ls-files *",
    "git -C * grep *",
    "git -C * ls-remote *",
    "cat *",
    "head *",
    "tail *",
    "ls",
    "ls *",
    "grep *",
    "wc *"
  ]
}
